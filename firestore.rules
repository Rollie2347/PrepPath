rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isOwner(uid) { return signedIn() && request.auth.uid == uid; }

    // Question bank: read-only for clients; written by the content pipeline (admin SDK).
    match /questions/{id} {
      allow read: if signedIn();
      allow write: if false;
    }

    match /users/{uid} {
      allow read: if isOwner(uid);
      // Created by the initUser function. Clients may only change presentation settings;
      // everything under `game` (XP, gems, streak, league) is server-owned.
      allow create, delete: if false;
      allow update: if isOwner(uid)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['activeTest', 'dailyXpGoal', 'avatar', 'tests', 'blocked'])
        && (!('blocked' in request.resource.data) || (request.resource.data.blocked is list && request.resource.data.blocked.size() <= 500))
        // Tests can be added from the switcher, never removed (progress for both is kept).
        && ['sat', 'act'].hasAll(request.resource.data.tests)
        && request.resource.data.tests.size() <= 2
        && request.resource.data.tests.hasAll(resource.data.tests)
        && request.resource.data.activeTest in request.resource.data.tests
        && request.resource.data.dailyXpGoal in [20, 50, 100, 150];

      // Progress: clients may only edit bookmarks; mastery/nodes/mistakes come from functions.
      match /state/progress {
        allow read: if isOwner(uid);
        allow create, update: if isOwner(uid)
          && (resource == null
                ? request.resource.data.keys().hasOnly(['bookmarks'])
                : request.resource.data.diff(resource.data).affectedKeys().hasOnly(['bookmarks']))
          && request.resource.data.bookmarks is list
          && request.resource.data.bookmarks.size() <= 500;
      }

      match /quests/{day} {
        allow read: if isOwner(uid);
        allow write: if false;
      }

      match /attempts/{id} {
        allow read: if isOwner(uid);
        allow write: if false;
      }
    }

    // League cohorts: members can see their own cohort's leaderboard.
    match /leagues/{cohortId} {
      allow read: if signedIn() && request.auth.uid in resource.data.members;
      allow write: if false;
    }
  }
}
