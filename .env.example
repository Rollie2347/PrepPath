# Copy to .env (gitignored) and fill in.
# Used by content/pipeline (generate/verify). Never prefix with EXPO_PUBLIC_ — that would ship it in the app.
ANTHROPIC_API_KEY=
# 1 = dev builds talk to the local Firebase emulators (npm run emulators). Remove once functions are on Blaze.
EXPO_PUBLIC_USE_EMULATORS=1
